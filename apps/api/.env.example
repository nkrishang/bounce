# RPC URL (Polygon)
POLYGON_RPC_URL=https://polygon-rpc.com

# Server configuration
PORT=3001
HOST=0.0.0.0

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# PostgreSQL (local: docker-compose up, prod: Railway Postgres)
DATABASE_URL=postgresql://bounce:bounce@localhost:5432/bounce

# Redis URL (leave empty to use in-memory fallback)
REDIS_URL=redis://localhost:6379

# Privy (for API authentication — get from dashboard.privy.io > Settings)
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret
